# 线上环境
VITE_USER_NODE_ENV = production

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = hash

# 是否启用 gzip 或 brotli 压缩打包，如果需要多个压缩规则，可以使用 “,” 分隔
# Optional: gzip | brotli | none
VITE_BUILD_COMPRESS = none

# 打包压缩后是否删除源文件
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 是否开启 VitePWA
VITE_PWA = true

# 线上环境接口地址
#
# 必须留空。Go 服务同时托管 /api/* 和前端 dist，同源，不需要额外前缀。
# 而 api/modules/*.ts 里每条路径都自带 `/api/...`（PORT1 为空串），
# 这里再填 /api 会被 axios 当成 baseURL 叠上去，请求变成 /api/api/login，
# 后端没有这个路由 → 登录点了没反应。
#
# 注意 media 的 streamUrl / downloadUrl 是后端直接下发的 /api/media/... ，
# 由 <audio src> 和 window.open 直接使用，不走 axios、拿不到 baseURL。
# 也就是说 baseURL 只要非空，这两条路径就和其余接口对不上。留空是唯一自洽的取值。
VITE_API_URL = ""
