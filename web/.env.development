# 本地环境
VITE_USER_NODE_ENV = development

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = hash

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 是否开启 VitePWA
VITE_PWA = false

# 开发环境接口地址（axios 的 baseURL）
#
# 留空，与 .env.production 保持一致 —— 接口路径里的 /api 前缀已经写在
# src/api/modules/*.ts 里了（如 `/api/login`），baseURL 再补一次会变成
# /api/api/login，只能靠代理剥掉一层来抵消，前缀在三个地方各写一遍，
# 极易改错。留空后：代码写什么路径，浏览器就发什么，后端就收到什么。
VITE_API_URL = ""

# 开发环境跨域代理，支持配置多个
# 格式：[前缀, 目标地址, 是否剥掉前缀?]，第三项默认 false（原样转发），
# 详见 build/proxy.ts。指向真实后端时保持默认，前缀原样带过去。
VITE_PROXY = [["/api","http://192.168.2.159:8080"]]
# mock 服务的目标地址自带路径，需要把第三项设为 true 来剥掉 /api：
# VITE_PROXY = [["/api","https://mock.mengxuegu.com/mock/629d727e6163854a32e8307e",true]]
# VITE_PROXY = [["/api","https://www.fastmock.site/mock/f81e8333c1a9276214bcdbc170d9e0a0",true]]
# VITE_PROXY = [["/api-easymock","https://mock.mengxuegu.com",true],["/api-fastmock","https://www.fastmock.site",true]]
