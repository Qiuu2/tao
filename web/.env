# 产品名。侧边栏 Logo、浏览器标签页标题、登录页标题都取这里。
# 名字沿用旧版：ok112/language/chinese.php 里的
#   $index_top['Digital_Network_PA_System'] = 'IP数字网络广播系统'
# 原来是模板自带的 "Geeker Admin"。
VITE_GLOB_APP_TITLE = IP数字网络广播系统

# 本地运行端口号
VITE_PORT = 8848

# 启动时自动打开浏览器
VITE_OPEN = true

# 开启 devTools 调试
VITE_DEVTOOLS = false

# 打包后是否生成包分析文件
VITE_REPORT = false

# 开启 CodeInspector 调试
VITE_CODEINSPECTOR = false
