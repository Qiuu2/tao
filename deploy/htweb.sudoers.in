# htweb 需要的免密提权（模板，由 deploy/install.sh 替换占位符后安装）
#
# 安装位置：/etc/sudoers.d/htweb      权限：0440 root:root
# 占位符：  @SERVICE_USER@ = 跑 htweb 的账号（现网 tw）
#           @A9000_ROOT@   = 旧系统安装根目录（现网 /opt/apps/a9000）
#
# ─────────────────────────────────────────────────────────────
# 为什么需要这些
#
# htweb 以普通账号运行（不是 root，也不该是）。但「服务器信息」和「时间设置」
# 两页上有三个动作绕不开 root：
#
#   设置服务器时间 / 同步当前时间 → timedatectl set-time
#   （手工设时间前关掉自动校时）  → timedatectl set-ntp
#                                  systemctl stop <那几个校时守护>
#   服务器信息里改 IP / 掩码 / 网关 → nmcli connection modify / up
#   主备配置改 /etc 下那几个文件   → htweb-ha-apply（本目录下的小脚本）
#   地址或主备角色改完重启两个服务 → systemctl stop/start heartbeat
#                                  （或 /etc/init.d/heartbeat，SysV 那一套）
#                                  docker restart a9000_audioserver
#   版本设置的「提交」            → update_audioserver.sh，它内部全是 sudo docker
#
# 没有这几条时程序不会去猜密码、也不会假装成功：接口会探测一次，
# 探不通就把「缺哪条 sudoers」原样显示在页面上，按钮置灰。
# 装上这个文件之后按钮立刻可用，不需要改代码、不需要重启 htweb。
#
# ─────────────────────────────────────────────────────────────
# 为什么只放开这几条
#
# 没有写成 `@SERVICE_USER@ ALL=(ALL) NOPASSWD: ALL`。
# 上面三件事之外的任何提权，htweb 都不需要，也就不给。
#
# ⚠ update_audioserver.sh 这条等于把「重建 audioserver 容器」的能力给了 htweb。
#   这是版本设置页的全部意义所在，避不开；接口那一侧挂在**超管**路由上、
#   界面还要再确认一次，作为补偿。
#
# ⚠ 脚本路径写死在这里。谁能改这个脚本，谁就等于拿到了 root ——
#   所以 install.sh 会检查它属主是不是 root 或服务账号本人，
#   并且**不允许**它对其它用户可写。
#
# ⚠ HTWEB_NET 那两条带 *，等于把「改任意 NetworkManager 连接」的能力给了 htweb。
#   收不窄：连接名每台机器都不一样（麒麟 V10 上默认是「有线连接 1」，
#   别的发行版是 Wired connection 1），属性也得带参数。
#   这是「在 Web 上改服务器 IP」这件事本身的代价。作为补偿：接口挂在 serverpriv 上、
#   改完留一行操作日志、程序只会用这两个子命令（modify / up），代码里不拼 shell。
#
#   不需要在 Web 上改 IP 的部署，把 HTWEB_NET 从最后那行里删掉即可 ——
#   程序探不到权限就跳过网卡那一步并在页面上说明原因，不报错、也不假装成功。
#
# ⚠ HTWEB_HA 这条**不带 ***：htweb 只能传一个目标名（hosts / hostname / ha.cf /
#   haresources / ha-post / crontab），路径写死在脚本里，内容走 stdin，
#   脚本落盘前还要体检（hosts 必须有 127.0.0.1 那一行、hostname 只能一行…）。
#   所以这条 sudo 能改的只有那 6 个文件，不是系统里任意位置。
#
#   ⚠⚠ htweb-ha-apply 必须是 root 属主、且服务账号不可写 ——
#       谁能改那个脚本，谁就等于拿到了 root。install-sudoers.sh 会检查这一点。
#   不做主备的部署把 HTWEB_HA 删掉即可，主备那一页会整组跳过并说明原因。
#
# ⚠ HTWEB_SVC 这几条**一个星号都没有**：服务名和容器名都写死在规则里，
#   htweb 只能停/起 heartbeat 这一个服务、重启 a9000_audioserver 这一个容器，
#   动不了别的东西，更不能 `docker run` 任何镜像。
#   （注意 `docker restart` 与 `docker run` 是两条不同的子命令，
#   这条规则给不出后者 —— 后者在 HTWEB_AUDIO 那个脚本里，是另一回事。）
#
#   为什么是 stop / start 两条而不是一条 restart：改完 haresources 再 restart
#   是错的 —— heartbeat 放下资源照的是**当前磁盘上**那份 haresources，
#   文件先改了，它就会去释放一个从没起来过的新地址，而旧的虚拟地址没人摘。
#   必须「先停（旧配置在，旧地址被摘干净）→ 写文件 → 再起（读到新配置）」。
#   详见 server/internal/serverparam/svcrestart.go 开头。
#
#   /etc/init.d/heartbeat 那两条是 SysV 的退路：这套 a9000 是 ubuntu-autoinstall
#   装出来的，机器上不一定有 heartbeat.service。程序先探单元、探不到才走 init.d。
#
#   删掉这一条的话，保存照常完成，页面上会说这两个服务没能按新配置起来并给出手工命令。

# ⚠ HTWEB_CLOCK 的 stop 那几条也是**没有星号**的：单元名一个个写死。
#   非它们不可的原因：systemd 的 timedated 在自动校时开着时会直接拒绝 SetTime
#   （Automatic time synchronization is enabled），而 `timedatectl set-ntp false`
#   只管得住 timesyncd 和在 /usr/lib/systemd/ntp-units.d/ 里登记过的单元 ——
#   ha-post.sh 第 13 行直接 `systemctl start ntp.service` 起来的那个未必算数。
#   名单与 server/internal/timeset/clock.go 的 ntpUnits 一一对应。

Cmnd_Alias HTWEB_CLOCK = @TIMEDATECTL@ set-time *, @TIMEDATECTL@ set-ntp *, \
                         @SYSTEMCTL@ stop systemd-timesyncd, @SYSTEMCTL@ stop ntp, \
                         @SYSTEMCTL@ stop ntpd, @SYSTEMCTL@ stop chronyd, \
                         @SYSTEMCTL@ stop chrony
Cmnd_Alias HTWEB_NET   = @NMCLI@ connection modify *, @NMCLI@ connection up *
Cmnd_Alias HTWEB_HA    = @A9000_ROOT@/htweb/htweb-ha-apply
Cmnd_Alias HTWEB_SVC   = @SYSTEMCTL@ stop heartbeat, @SYSTEMCTL@ start heartbeat, \
                         /etc/init.d/heartbeat stop, /etc/init.d/heartbeat start, \
                         @DOCKER@ restart a9000_audioserver
Cmnd_Alias HTWEB_AUDIO = @A9000_ROOT@/script/cmd/update_audioserver.sh

@SERVICE_USER@ ALL=(root) NOPASSWD: HTWEB_CLOCK, HTWEB_NET, HTWEB_HA, HTWEB_SVC, HTWEB_AUDIO
