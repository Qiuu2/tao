#!/bin/bash
#
# htweb 唯一一条能写 root 配置文件的口子。
#
#     sudo htweb-ha-apply <目标名>           < 新内容      写
#     sudo htweb-ha-apply <目标名> remove                 删（先留 .htweb.bak）
#
# 「主备服务器配置」那一页要改 /etc/hosts、/etc/hostname、/etc/ha.d/* 和
# /etc/crontab，而 htweb 跑在普通账号下（现网 tw），写不了这几个文件。
#
# ─────────────────────────────────────────────────────────────
# 为什么是这个形状
#
# **htweb 不传路径，只传一个目标名**。路径写死在下面那张表里，
# 传进来的名字对不上就直接退出。这样即使 htweb 自己被人拿下，
# 这条 sudo 也只能覆盖这 6 个文件中的一个，不能写系统里任意位置。
#
# **新内容走 stdin，不走参数**。参数会进 ps、进 sudo 日志；
# 而且文件内容里有换行，当参数传迟早出事。
#
# **改哪一行由 htweb 算好**。这里只负责「把这段内容原子地放到那个位置」。
# 内容是 htweb 按锚点（node / dstip= / 127.0.0.1 …）改好的整份文件 ——
# 这个脚本刻意不碰 sed，旧版那套按行号 sed 的毛病不能在这儿重演。
#
# ─────────────────────────────────────────────────────────────
# ⚠ 这个文件本身必须是 root 的、且别人不可写
#
# 谁能改这个脚本，谁就等于拿到了 root。install-sudoers.sh 会检查这一点。

set -euo pipefail

die() { echo "htweb-ha-apply: $*" >&2; exit 1; }

TARGET="${1:-}"
ACTION="${2:-write}"
[ -n "$TARGET" ] || die "用法：htweb-ha-apply <目标名> [remove] < 新内容"
case "$ACTION" in
  write|remove) ;;
  *) die "不认识的动作 $ACTION（只接受 write / remove）" ;;
esac

# 目标名 → 绝对路径 + 权限位。**这张表是唯一的白名单**。
case "$TARGET" in
  hosts)       DEST=/etc/hosts;             MODE=644 ;;
  hostname)    DEST=/etc/hostname;          MODE=644 ;;
  ha.cf)       DEST=/etc/ha.d/ha.cf;        MODE=644 ;;
  haresources) DEST=/etc/ha.d/haresources;  MODE=644 ;;
  ha-post)     DEST=/etc/ha.d/ha-post.sh;   MODE=755 ;;
  crontab)     DEST=/etc/crontab;           MODE=644 ;;
  *) die "不认识的目标名 $TARGET（只接受 hosts / hostname / ha.cf / haresources / ha-post / crontab）" ;;
esac

# 只同步**已经存在**的配置，不负责安装。
# 这台机器没装 heartbeat 就不该由这个脚本去创建 /etc/ha.d/ 下的文件。
[ -f "$DEST" ] || {
  [ "$ACTION" = remove ] && { echo "ok $DEST 本来就不在"; exit 0; }
  die "$DEST 不存在，不创建（这台机器可能没装这一套）"
}

# ── 删 ──
#
# 目前只有主机上的 /etc/crontab 会走到这里（旧版是 `rm -rf /etc/crontab`，
# 主机不跑备机那几条定时任务）。
#
# ⚠ 先留一份 .htweb.bak 再删：这台机器上可能有别人加的定时任务，
#   旧版一删就没了，也没有任何地方能查回来。备份留不下就不删。
if [ "$ACTION" = remove ]; then
  case "$TARGET" in
    crontab) ;;
    *) die "$TARGET 不允许删除（只有 crontab 可以）" ;;
  esac
  cp -p "$DEST" "$DEST.htweb.bak" || die "留不下备份，没有退路就不删 $DEST"
  rm -f "$DEST"
  echo "ok 已删除 $DEST（旁边留了 $DEST.htweb.bak）"
  exit 0
fi

TMP="$(mktemp "${DEST}.htweb.XXXXXX")"
trap 'rm -f "$TMP"' EXIT
cat > "$TMP"

# ── 内容体检 ──
#
# 写坏这几个文件里的任何一个，机器就可能连不上或者起不来，
# 而那时候已经没有界面可以改回来了。所以宁可拒绝，也不写一个看着不对的东西。
[ -s "$TMP" ] || die "新内容是空的，拒绝写入 $DEST"

case "$TARGET" in
  hosts)
    grep -qE '^[[:space:]]*127\.0\.0\.1[[:space:]]' "$TMP" \
      || die "新的 hosts 里没有 127.0.0.1 那一行，拒绝写入"
    ;;
  hostname)
    [ "$(wc -l < "$TMP")" -le 1 ] || die "hostname 只能是一行，拒绝写入"
    grep -qE '^[A-Za-z0-9][A-Za-z0-9.-]*$' "$TMP" \
      || die "主机名形态不对，拒绝写入"
    ;;
  ha.cf)
    grep -qE '^[[:space:]]*node[[:space:]]' "$TMP" \
      || die "新的 ha.cf 里没有 node 行，拒绝写入"
    ;;
esac

# ── 留一份回退 ──
#
# 只留最近一次。这几个文件都不大，而攒一堆 .bak 反而没人知道该用哪个。
cp -p "$DEST" "$DEST.htweb.bak" 2>/dev/null || true

chmod "$MODE" "$TMP"
chown root:root "$TMP"
# 同一文件系统内的 mv 是原子的：要么旧的、要么新的，不会出现半个文件
mv -f "$TMP" "$DEST"
trap - EXIT

echo "ok $DEST"
