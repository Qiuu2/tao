# htweb 运行配置样例
#
# deploy/install.sh 只在目标机器上**还没有** config.yaml 时才拷这个文件过去，
# 已经存在就绝不覆盖 —— 里面有数据库密码和 JWT 密钥。
#
# 首次安装后必须改的两处已用 ⚠ 标出。

server:
  # 避开旧系统已占用的 80/81/99/8000/8090
  listen: ":8080"
  # 前端 dist 目录（放在 Apache 的 DocumentRoot 下，Apache 也能顺带托管）
  static_dir: "/opt/apps/a9000/html/htweb"

database:
  # 3306 是 Docker 发布到宿主的端口；容器内的主机名 mysql 在宿主上解析不到
  host: "127.0.0.1"
  port: 3306
  # ⚠ 改成这台机器上的专用账号。
  #   只给 SELECT/INSERT/UPDATE/DELETE，**不要给任何 DDL 权限** ——
  #   零 DDL 是这套系统与旧库共存的前提（R1 红线）。建账号语句：
  #
  #     CREATE USER 'htweb'@'%' IDENTIFIED BY '<换成强口令>';
  #     GRANT SELECT, INSERT, UPDATE, DELETE ON `audioserver`.* TO 'htweb'@'%';
  #
  user: "htweb"
  pass: "CHANGE-ME"
  name: "audioserver"
  max_open: 8
  max_idle: 8

media:
  # 宿主真实路径 = root + media.filename
  # 这一项同时也是「版本设置」页找版本包和 update_audioserver.sh 的依据
  root: "/opt/apps/a9000"
  max_upload_mb: 300
  ffmpeg: "/opt/apps/a9000/bin/ffmpeg"

notify:
  host: "127.0.0.1"
  # 0 = 运行时从 serverbaseparam.webport 读取，不硬编码
  port: 0
  enabled: true

# 厂商 SDK 的二进制命令端口。目前只有看板首页那四个紧急广播按钮走这里。
# 与上面的 notify 是两套协议、两个端口，不要混。
sdk:
  # 后台广播服务地址。厂商示例里写的是 docker 内的主机名 audioserver，
  # 新版跑在宿主上，走已发布的回环端口。
  host: "127.0.0.1"
  port: 8885
  # 关掉后只记日志不真发包。⚠ 这条命令一发出去全场喇叭就响，
  # 联调期先设 false。
  enabled: true

auth:
  # ⚠ 换成一串随机值，别沿用样例。生成一个：
  #     head -c 32 /dev/urandom | base64 | tr -d '=+/'
  secret: "CHANGE-ME"
  ttl: 8h
  captcha_enabled: true

logs:
  # ⚠ 这里没有任务日志目录：任务日志那一页已经撤掉，后台 C 服务写在
  # datelog/ 下的 logYYYY-MM-DD.html 新版一概不读也不删。
  # 老配置里留着 task_dir 也没关系，多余的键会被忽略。
  # 日志保留期这类界面上能改的设置存这个 JSON 文件里。
  # 留空则取 <备份目录的上级>/logsettings.json。
  #
  # 为什么不进数据库：零 DDL 是与旧库共存的前提（R1 红线），不能给 log 表加列、
  # 也不能建新表；现有的空表又都可能被后台 C 服务扫描，塞进去有触发误广播的风险。
  #
  # 保留期默认 1 个月，可选 3 个月 / 半年 / 1 年，超期的每天滚一次
  # （操作日志按 time 删、任务日志按文件名里的日期删）。详见 logs/retention.go。
  # settings_file: "/opt/apps/a9000/htweb/logsettings.json"

backup:
  dir: "/opt/apps/a9000/htweb/backups"
  # 媒体物理目录；留空则取 media.root + /backup/mediadata
  media_dir: "/opt/apps/a9000/backup/mediadata"

register:
  # 注册服务（「基础配置 → 注册服务」页）。旧版把这三样写死在 do.php 里。
  #
  # 注册命令：旧版 `registerserver <注册码>`，取标准输出第一行判定
  # success / failed / expired。留空则用 registerserver（走 PATH）。
  command: "registerserver"
  # 试用起算日文件。⚠ 试用剩余天数是从这个文件算的，不是从库里的 trystartdate ——
  # 旧版页面里读 trystartdate 的那段被整段注释掉了。文件形如：
  #     [system]
  #     startdate=2016-08-31
  # 留空则页面算不出剩余天数（会如实说明，而不是猜一个日期）。
  serial_file: "/opt/apps/a9000/html/ok112/serial"
  # 领过试用后留下的标记文件；存在即不允许再领。留空则禁用「试用」按钮。
  trial_file: "/opt/apps/a9000/html/ok112/serialtwo"

assistant:
  # AI 助手。关掉时整组路由不注册，前端也拿不到入口。
  enabled: false
  # 本机 NLU 推理服务（nlu/server.py）。**与 htweb 同机，只走回环**。
  # 那个服务没有鉴权，绝不能对外暴露；鉴权在 htweb 这一侧做
  # （助手接口要登录，每个意图按用户组权限位卡）。
  nlu_url: "http://127.0.0.1:5013"
  # 单次推理超时。模型很小，正常 100ms 内；给 5s 是为了容忍冷启动加载权重。
  nlu_timeout: 5s
  # 会话上下文多久算过期。过期后「刚才那个」这类指代失效，重新开始一轮。
  session_ttl: 30m
  # 撤销凭据的有效期。广播是有时效的 —— 十分钟前取消的早读现在可能已经过了
  # 播出时间，那时候再「撤销」只会让人以为恢复了。
  undo_ttl: 10m
  # 指令历史按用户保留多少条
  history_limit: 1000

# legacy 一节可以整段省掉 —— 不写就用下面这两个默认值，现网正是如此。
# 只在旧系统装在别的路径时才需要显式写出来。
#
# 这两个文件是「服务器基本信息」页上 web端口 / sdk端口 的来源：
# 它们不在数据库里，而在 Apache 配置和旧版 swagger 文档里。
# ⚠ 只读解析，绝不回写 —— 旧版改这两处用的是按行号 sed（D-209），
#   行数一变就会写坏 httpd.conf，整个站点起不来。
#
# legacy:
#   apache_conf: "/opt/apps/a9000/home/apache/httpd.conf"
#   swagger_file: "/opt/apps/a9000/html/ok112/swagger-ui/dist/swagger1.json"
