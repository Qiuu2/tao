worker_processes      1;

events {
  worker_connections  1024;
}

http {
  include             mime.types;
  default_type        application/octet-stream;

  sendfile on;

  keepalive_timeout   65;
  post_max_size = 80M
  upload_max_filesize = 50M
  server {
    listen            8080;
    server_name       localhost;

    location / {
      root            html;
      index           index.html index.htm;
    }
  }
}
