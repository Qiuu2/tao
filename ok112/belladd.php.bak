	$smarty->assign("terminalist",$terminalist);
	
	//获取打铃文件夹中文件
	$result = mysql_query("SELECT media.id, media.name FROM media WHERE media.folderid = 2 order by id desc");

	if(mysql_fetch_array($result))
	{
		@mysql_data_seek($result, 0);

		while($row = mysql_fetch_array($result))
		{
			$medialist[] = array("id"=>$row['id'],"name"=>$row['name']);
		}

		$smarty->assign("medialist",$medialist);

		unset($medialist);

		@mysql_free_result($result);
	}
